{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["REDIS_URL", "DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
