NODE_ENV=development

WEB_PORT=5173
API_PORT=3000
VITE_API_URL=http://localhost:3000/api/v1

# Neon pooled connection for the API runtime
DATABASE_URL=postgresql://USER:PASSWORD@EP-ID-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require
# Neon direct connection for migrations; omit -pooler from the endpoint hostname
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@EP-ID.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require
DATABASE_POOL_SIZE=10

WEB_ORIGIN=http://localhost:5173
REDIS_URL=redis://:asset_dev_password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-local-env

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=asset-local
S3_SECRET_KEY=change-me-in-local-env
S3_BUCKET=asset-files
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=debug
LOG_PRETTY=true
LOG_HEALTH_REQUESTS=false
