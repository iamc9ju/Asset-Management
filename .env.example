NODE_ENV=development

WEB_PORT=5173
API_PORT=3000
HTTP_TRUST_PROXY_HOPS=0
VITE_API_URL=http://localhost:3000/api/v1
OPENAPI_ENABLED=true
OPENAPI_UI_ENABLED=true

AUTH_JWT_ISSUER=asset-management-api
AUTH_JWT_AUDIENCE=asset-management-web
AUTH_JWT_CURRENT_KID=v1
AUTH_JWT_CURRENT_SECRET=change-me-with-a-random-jwt-secret-of-at-least-256-bits
# Configure both previous-key values only during a controlled signing-key rotation.
# AUTH_JWT_PREVIOUS_KID=v0
# AUTH_JWT_PREVIOUS_SECRET=replace-with-the-previous-random-jwt-signing-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_IDLE_TTL_SECONDS=604800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_IP_RATE_LIMIT=100
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_IP_RATE_LIMIT=300
AUTH_REFRESH_RATE_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_KEY_SECRET=change-me-with-a-random-rate-limit-secret-of-at-least-256-bits
AUTH_RATE_LIMIT_NAMESPACE=asset-management-development
AUTH_SESSION_RETENTION_SECONDS=2592000
AUTH_CLEANUP_BATCH_SIZE=500
AUTH_CLEANUP_MAX_BATCHES=20
# Set true in production. Local HTTP uses the unprefixed am_refresh cookie name.
AUTH_REFRESH_COOKIE_SECURE=false

# Neon pooled connection for the API runtime
DATABASE_URL=postgresql://USER:PASSWORD@EP-ID-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require
# Neon direct connection for migrations; omit -pooler from the endpoint hostname
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@EP-ID.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require
DATABASE_POOL_SIZE=10

# One-time administrator bootstrap metadata. Supply the password only through stdin.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator

WEB_ORIGIN=http://localhost:5173
REDIS_URL=redis://:asset_dev_password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-local-env

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=asset-local
S3_SECRET_KEY=change-me-in-local-env
S3_BUCKET=asset-files
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=debug
LOG_PRETTY=true
LOG_HEALTH_REQUESTS=false
