{
  "name": "@asset-management/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "pnpm run test:all",
    "test:unit": "jest --passWithNoTests --runInBand --testPathIgnorePatterns='\\.integration\\.spec\\.ts$'",
    "test:integration": "jest --passWithNoTests --runInBand --testPathPatterns='\\.integration\\.spec\\.ts$'",
    "test:openapi": "jest --passWithNoTests --runInBand src/config/environment.schema.spec.ts src/config/openapi.config.spec.ts src/config/openapi.config.integration.spec.ts src/shared/http/openapi/api-response.openapi.spec.ts",
    "test:responses": "jest --passWithNoTests --runInBand src/shared/http/responses src/shared/http/openapi/api-response.openapi.spec.ts src/modules/auth/presentation/auth.controller.integration.spec.ts",
    "test:auth": "jest --passWithNoTests --runInBand src/modules/auth src/shared/http/errors/http-error.mapper.spec.ts src/config/environment.schema.spec.ts",
    "test:auth:protected": "jest --passWithNoTests --runInBand src/modules/auth/application/services/authenticate-access-token.service.spec.ts src/modules/auth/presentation/guards/access-token.guard.spec.ts src/modules/auth/presentation/guards/permission.guard.spec.ts src/modules/auth/presentation/decorators/require-permissions.decorator.spec.ts src/modules/auth/presentation/auth.controller.integration.spec.ts src/modules/auth/presentation/permission-enforcement.integration.spec.ts src/modules/auth/infrastructure/crypto/jwt-access-token.service.spec.ts",
    "test:auth:refresh": "jest --passWithNoTests --runInBand src/modules/auth/application/services/refresh-session.service.spec.ts src/modules/auth/domain/session-policy.spec.ts src/modules/auth/infrastructure/crypto/opaque-refresh-token.service.spec.ts src/modules/auth/infrastructure/typeorm/auth-session.repository.integration.spec.ts src/modules/auth/presentation/auth-cookie.service.spec.ts src/modules/auth/presentation/guards/auth-origin.guard.spec.ts src/modules/auth/presentation/auth.controller.integration.spec.ts src/config/environment.schema.spec.ts src/config/openapi.config.spec.ts src/config/openapi.config.integration.spec.ts",
    "test:bootstrap": "jest --passWithNoTests --runInBand src/database/bootstrap",
    "test:db": "jest --passWithNoTests --runInBand src/config/typeorm-cli.config.spec.ts src/database/testing/test-database.spec.ts src/database/migrations/initial-schema.integration.spec.ts src/database/seeds/seed-permissions-and-roles.integration.spec.ts src/database/bootstrap/bootstrap-administrator.integration.spec.ts src/modules/iam/infrastructure/typeorm/iam-auth-query.repository.integration.spec.ts src/modules/auth/infrastructure/typeorm/auth-session.repository.integration.spec.ts",
    "test:seed": "jest --passWithNoTests --runInBand src/database/seeds/seed-permissions-and-roles.spec.ts src/database/seeds/seed-permissions-and-roles.integration.spec.ts",
    "test:all": "jest --passWithNoTests --runInBand",
    "typecheck": "tsc --noEmit",
    "migration:generate": "typeorm-ts-node-commonjs -d src/config/typeorm-cli.config.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d src/config/typeorm-cli.config.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/config/typeorm-cli.config.ts migration:revert",
    "seed:permissions-and-roles": "ts-node src/database/seeds/seed-permissions-and-roles.ts",
    "bootstrap:administrator": "ts-node src/database/bootstrap/bootstrap-administrator.cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.7.0",
    "nestjs-pino": "5.1.0",
    "pg": "^8.16.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "jest": "^30.1.2",
    "pino-pretty": "13.1.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
