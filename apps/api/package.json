{
  "name": "@asset-management/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "migration:generate": "typeorm-ts-node-commonjs -d src/config/typeorm-cli.config.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d src/config/typeorm-cli.config.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/config/typeorm-cli.config.ts migration:revert"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "jest": "^30.1.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
